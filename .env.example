# Bu dosyayı .env olarak kopyala ve değerleri doldur.

# LLM sağlayıcısı (şimdilik: gemini)
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey adresinden alınır
GEMINI_API_KEY=
# Kullanılacak Gemini modeli (güncel model adlarını AI Studio'da kontrol et)
GEMINI_MODEL=gemini-flash-latest
# Ana model yoğunsa sırayla denenecek yedek modeller
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Obsidian vault klasörü (proje köküne göre ya da tam yol)
VAULT_PATH=vault

# Eklentinin backend'e erişim anahtarı. Boş bırakırsan ilk açılışta otomatik üretilir.
API_TOKEN=

HOST=127.0.0.1
PORT=8765
